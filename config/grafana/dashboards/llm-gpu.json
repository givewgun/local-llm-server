      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Graphics clock",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nvidia_smi_clocks_current_graphics_clock_hz)",
          "legendFormat": "graphics",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
