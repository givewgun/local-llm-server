# Copy to .env with `./llmctl init` — it fills every CHANGE_ME with a random secret.
# .env is git-ignored. Never commit it.

# ---------------------------------------------------------------- what runs
# Comma-separated compose profiles: vllm, ollama, tunnel, monitoring, webui.
# Gateway (LiteLLM + Postgres) always runs.
COMPOSE_PROFILES=vllm,tunnel,monitoring

# ------------------------------------------------------------------- model
# File name (without .yaml) in models/. Switch with `./llmctl model use <preset>`.
MODEL_PRESET=qwen3-8b-awq
# Fraction of total VRAM vLLM may claim. Leave headroom for the desktop / Ollama.
VLLM_GPU_MEMORY_UTILIZATION=0.70
# Only needed for gated Hugging Face models.
HF_TOKEN=

# ------------------------------------------------------------------- domain
API_HOSTNAME=llm.example.com
# Only routed when the webui profile is enabled.
CHAT_HOSTNAME=chat.example.com
TUNNEL_NAME=llm-server

# ------------------------------------------------------------------ backends
# Defaults assume single-node. For a remote GPU worker, point at its Tailscale name,
# e.g. VLLM_API_BASE=http://gpu-box.tailnet.ts.net:8000/v1
VLLM_API_BASE=http://vllm:8000/v1
# Native Ollama on the host (Windows/macOS). Use http://ollama:11434 with the ollama profile.
OLLAMA_API_BASE=http://host.docker.internal:11434
# Bind address for vLLM's published port. 127.0.0.1 = local only.
# Set to this machine's Tailscale IP when it is a worker for a remote gateway.
VLLM_BIND_ADDR=127.0.0.1

# ------------------------------------------------------------------- secrets
LITELLM_MASTER_KEY=CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME
VLLM_API_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
OPEN_WEBUI_SECRET_KEY=CHANGE_ME
# Virtual key Open WebUI uses to call the gateway. Create with:
#   ./llmctl key create open-webui
OPEN_WEBUI_LITELLM_KEY=

# ------------------------------------------------------------ image versions
# Pinned for reproducibility. Bump deliberately; see docs/operations.md#upgrades.
VLLM_IMAGE_TAG=v0.32.0
LITELLM_IMAGE_TAG=v1.106.6
POSTGRES_IMAGE_TAG=17.11-alpine3.23
CLOUDFLARED_IMAGE_TAG=2026.10.5
PROMETHEUS_IMAGE_TAG=v3.15.1
GRAFANA_IMAGE_TAG=13.2.5
OPEN_WEBUI_IMAGE_TAG=v0.12.4
OLLAMA_IMAGE_TAG=0.40.12
